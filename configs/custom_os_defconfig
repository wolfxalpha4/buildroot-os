# 64-bit Architecture
BR2_x86_64=y

# Linux Kernel Headers matching Kernel 6.6
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

# Standard GNU C Library (glibc) - NO musl!
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_INSTALL_LIBSTDCPP=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Linux Kernel (Standard QEMU x86_64)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.21"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/x86_64/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Skip compiling host QEMU in buildroot (saves ~20 mins and 3GB disk space)
# BR2_PACKAGE_HOST_QEMU is not set

# Networking & DHCP
BR2_SYSTEM_DHCP="eth0"

# SSH Server
BR2_PACKAGE_DROPBEAR=y

# Package Manager
BR2_PACKAGE_OPKG=y

# Audio Support for Doom
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# X11 Window System & Drivers
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XAPP_XTERM=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_VESA=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_MODESETTING=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_KEYBOARD=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_MOUSE=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y

# Retro Desktop Window Manager (Fluxbox: taskbar, clock, menu, workspaces)
BR2_PACKAGE_FLUXBOX=y

# Chocolate Doom & Official Shareware DOOM1.WAD
BR2_PACKAGE_CHOCOLATE_DOOM=y
BR2_PACKAGE_DOOM_WAD=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_X11=y
BR2_PACKAGE_SDL2_ALSA=y

# Target Filesystem (Ext4 512MB)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"

# Rootfs Overlay
BR2_ROOTFS_OVERLAY="board/custom/overlay"
